DATABASE_URL="postgresql://user:password@localhost:5432/kibrindes?schema=public"

# Conexão **direta** com o mesmo banco, sem pooler — usada só pelas migrations
# do build (`scripts/migrate-deploy.mjs`). Em Postgres local não há pooler, e
# aqui isso pode ficar vazio. Em produção, sim: pelo pgbouncer (Neon/Supabase)
# o advisory lock do `prisma migrate deploy` às vezes fica preso na conexão
# devolvida ao pool e o build seguinte morre com `P1002`. No Neon é a mesma URL
# sem o sufixo `-pooler` no host; a integração da Vercel também já injeta o
# valor como DATABASE_URL_UNPOOLED, que o script aceita no lugar deste.
DIRECT_URL=""

# String aleatória longa (ex: `openssl rand -hex 32`). Trocar em produção.
SESSION_SECRET="troque-este-valor-por-um-segredo-aleatorio"

# Vercel Blob — onde as artes enviadas pelos clientes ficam em produção. O
# valor vem pronto ao criar um Blob Store no dashboard e vincular ao projeto.
# Sem ele (dev local), a arte é gravada em var/uploads/artes.
BLOB_READ_WRITE_TOKEN=""

# Mercado Pago — pagamento real (Pix, cartão e boleto na tela deles).
# Credencial de produção ou de teste em
# https://www.mercadopago.com.br/developers/panel/app
# Sem este valor o checkout roda em modo simulado: o pedido nasce PAGO e
# nenhuma cobrança acontece.
MERCADOPAGO_ACCESS_TOKEN=""

# Chave secreta do webhook, criada junto com a URL de notificação no painel do
# Mercado Pago. Sem ela a assinatura dos eventos não é conferida — configure
# antes de rodar com dinheiro de verdade.
MERCADOPAGO_WEBHOOK_SECRET=""

# URL pública do site, usada nas back_urls e no notification_url do Mercado
# Pago. Em dev o webhook só chega através de um túnel (ex: ngrok) apontado aqui.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Número de WhatsApp da loja (com DDI, só dígitos — ex: 5511999999999). Usado
# na personalização "Criar com a gente" (abre uma conversa já com o produto e as
# variações escolhidas na mensagem), no botão flutuante e no link do rodapé. Sem
# ele nada disso aparece, em vez de quebrar silenciosamente num link wa.me vazio.
NEXT_PUBLIC_WHATSAPP_LOJA=""

# Link da loja na Shopee, usado no rodapé. Sem ele o item vira texto simples,
# em vez de um link que não leva a lugar nenhum.
NEXT_PUBLIC_SHOPEE_URL=""
