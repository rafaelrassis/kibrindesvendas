DATABASE_URL="postgresql://user:password@localhost:5432/kibrindes?schema=public"

# String aleatória longa (ex: `openssl rand -hex 32`). Trocar em produção.
SESSION_SECRET="troque-este-valor-por-um-segredo-aleatorio"

# Vercel Blob — onde as artes enviadas pelos clientes ficam em produção. O
# valor vem pronto ao criar um Blob Store no dashboard e vincular ao projeto.
# Sem ele (dev local), a arte é gravada em var/uploads/artes.
BLOB_READ_WRITE_TOKEN=""

# Mercado Pago — pagamento real (Pix, cartão e boleto na tela deles).
# Credencial de produção ou de teste em
# https://www.mercadopago.com.br/developers/panel/app
# Sem este valor o checkout roda em modo simulado: o pedido nasce PAGO e
# nenhuma cobrança acontece.
MERCADOPAGO_ACCESS_TOKEN=""

# Chave secreta do webhook, criada junto com a URL de notificação no painel do
# Mercado Pago. Sem ela a assinatura dos eventos não é conferida — configure
# antes de rodar com dinheiro de verdade.
MERCADOPAGO_WEBHOOK_SECRET=""

# URL pública do site, usada nas back_urls e no notification_url do Mercado
# Pago. Em dev o webhook só chega através de um túnel (ex: ngrok) apontado aqui.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
