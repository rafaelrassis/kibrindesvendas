{
  "name": "kibrindesvendas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/migrate-deploy.mjs && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:admin": "tsx prisma/promover-admin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.config.integration.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@prisma/client": "^6",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3",
    "lucide-react": "^1.31.0",
    "mercadopago": "^3.4.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "resend": "^6.20.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prisma": "^6",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
