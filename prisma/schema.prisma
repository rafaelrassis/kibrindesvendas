generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Categoria {
  id        String    @id @default(cuid())
  slug      String    @unique
  label     String
  // Substitui o emoji antigo: imagem de verdade enviada pelo admin. Sem
  // imagem cadastrada, a UI cai num ícone genérico.
  imagemUrl String?
  produtos  Produto[]
}

model Produto {
  id                   String            @id
  nome                 String
  descricao            String
  // Texto mais longo, opcional — exibido numa seção própria na página do
  // produto. `descricao` continua sendo o resumo curto de sempre.
  descricaoDetalhada   String?
  categoriaId          String
  categoria            Categoria         @relation(fields: [categoriaId], references: [id])
  preco                Decimal           @db.Decimal(10, 2)
  // Preço "de", riscado na vitrine e na página do produto. null = sem
  // desconto ativo. Quando preenchido, deve ser > preco (validado na UI e
  // na API admin); a diferença vira o badge de desconto percentual.
  precoOriginal        Decimal?          @db.Decimal(10, 2)
  precoShopee          Decimal           @db.Decimal(10, 2)
  vendidoNaShopee      Boolean           @default(true)
  requerPersonalizacao Boolean           @default(false)
  // Texto do alerta exibido na página do produto quando requerPersonalizacao
  // = true. null = usa o texto padrão ("Este produto passa por um fluxo de
  // personalização depois de escolhidas as variações.").
  mensagemPersonalizacao String?
  // Dias extras de produção somados ao prazo de frete retornado pelo Melhor
  // Envio, quando o produto exige personalização. 0 = não soma nada.
  diasProducaoExtra    Int               @default(0)
  // Menor quantidade que o cliente pode levar deste produto (ex: sacolinha
  // vendida em lote de 30). 1 = sem pedido mínimo, comportamento de sempre.
  quantidadeMinima     Int               @default(1)
  // true = o seletor de quantidade na página do produto e no checkout vira
  // um campo numérico livre em vez do stepper +/-, pra digitar pedidos
  // grandes (ex: 554un) sem clicar um por um.
  quantidadePersonalizavel Boolean       @default(false)
  emoji                String
  cor                  String
  // Galeria do produto: até 4 fotos (ordem = ordem de exibição) e 1 vídeo,
  // opcional. Sem nada aqui, a vitrine cai no emoji + cor de sempre.
  imagens              String[]          @default([])
  video                String?
  destaque             Boolean           @default(false)
  // Diferente de `destaque` (vitrine "Pode te interessar"): controla a
  // ordem dentro da prateleira da categoria na home (até 5 produtos).
  destaqueCategoria    Boolean           @default(false)
  // false = produto pausado: some da loja (vitrine, categoria, busca,
  // destaque e página de detalhe), mas continua no admin e nos pedidos já
  // feitos. Usado pra tirar de venda sem apagar (o que exigiria zerar os
  // pedidos que o referenciam primeiro).
  ativo                Boolean           @default(true)
  // null = estoque não controlado (comportamento de sempre — produto sob
  // encomenda ou sem controle de unidades). Com um número, o pedido não
  // deixa passar da quantidade disponível — ver decrementarEstoque, que usa
  // UPDATE condicional pra duas compras simultâneas não venderem a mesma
  // última unidade duas vezes.
  estoque              Int?
  // Usados no cálculo de frete real (Correios via Melhor Envio/SuperFrete).
  // Dimensões são de 1 unidade, em milímetros. `alturaMm` é a única que
  // empilha com a quantidade do pedido (ex: cartão, adesivo — cresce em pilha);
  // `larguraMm`/`comprimentoMm` são a base do produto e não mudam com a
  // quantidade. Valores padrão são de uma caixa pequena — produto sem
  // cadastro específico ainda recebe uma cotação plausível em vez de falhar.
  pesoMiligramas       Int               @default(300000)
  alturaMm             Int               @default(40)
  larguraMm            Int               @default(110)
  comprimentoMm        Int               @default(160)
  // CEP de onde este produto é despachado, quando difere do CEP padrão da
  // loja (config.cepOrigem) — ex: fornecedor terceirizado que despacha
  // direto pro cliente. null = usa o CEP padrão da loja.
  cepOrigemOverride    String?
  variacoes            Variacao[]
  // Custo de material é dado interno (usado pra calcular lucro no admin) —
  // nunca sai pela API pública, só pela rota /api/admin.
  materiais            MaterialProduto[]
  // Estoque por combinação de variação (ex: Cor:Preta|Tamanho:G). Produto
  // sem variações não usa isto — continua no campo `estoque` acima. Produto
  // com variações e controle ligado tem uma linha aqui por combinação; sem
  // nenhuma linha, o controle está desligado e o produto vende sem limite
  // (mesmo com variações cadastradas) — ver estoque-variacao.ts.
  estoqueVariacoes     EstoqueVariacao[]
  itensPedido          ItemPedido[]
  favoritos            Favorito[]
  avaliacoes           Avaliacao[]
  vendasShopee         VendaShopee[]
  // Overrides de margem pra venda manual na Shopee (área /admin/vendas-shopee).
  // null = usa o default global de ConfiguracaoLoja. Nunca sai pela API
  // pública, só pela rota /api/admin — mesmo tratamento de custo de material.
  shopeeComissaoPct    Decimal?          @db.Decimal(5, 2)
  shopeeFretePct       Decimal?          @db.Decimal(5, 2)
  shopeeAdsPct         Decimal?          @db.Decimal(5, 2)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

// Uma linha de material/insumo gasto no produto (ex: "Caneca branca", 1un,
// R$ 8,90). A soma de `quantidade * custoUnitario` de todas as linhas é o
// custo do produto, usado só internamente pra calcular a margem.
model MaterialProduto {
  id            String  @id @default(cuid())
  produtoId     String
  produto       Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  nome          String
  quantidade    Decimal @default(1) @db.Decimal(10, 3)
  custoUnitario Decimal @db.Decimal(10, 2)
}

// Estoque de uma combinação específica de variações (ex: Cor=Preta +
// Tamanho=G). `combinacao` é a chave canônica gerada por
// buildCombinacaoKey — tipos ordenados alfabeticamente, "tipo:valor"
// juntados por "|". Combinação pedida no checkout que não tem linha aqui
// (produto com controle ligado, mas grade desatualizada) é tratada como
// sem estoque — ver criarPedido.
model EstoqueVariacao {
  id         String   @id @default(cuid())
  produtoId  String
  produto    Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  combinacao String
  estoque    Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([produtoId, combinacao])
  @@index([produtoId])
}

model Variacao {
  id        String   @id @default(cuid())
  produtoId String
  produto   Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  tipo      String
  valores   String[]
  // Foto por valor — só usado quando tipo = "Cor" (case-insensitive); outros
  // tipos continuam mostrados como chip de texto. Chave = valor exatamente
  // como está em `valores`; sem entrada pro valor, cai no chip de texto de
  // sempre. Json em vez de tabela à parte porque é um mapa pequeno e nunca
  // é consultado por fora do próprio produto.
  imagensValores Json?
  // Preço final por valor (ex: "7x7" => 1.00, "10x10" => 5.00). Substitui o
  // preço base do produto quando o valor escolhido tem entrada aqui — não é
  // acréscimo. Sem entrada pro valor, usa o preço normal do produto. Ver
  // precoEfetivo em lib/estoque-variacao.ts.
  precosValores  Json?
  // Custo de material final por valor (ex: "7x7" => 0.80, "10x10" => 2.30).
  // Substitui a soma de MaterialProduto quando o valor escolhido tem entrada
  // aqui — mesmo padrão substitutivo de precosValores, não é acréscimo. Sem
  // entrada, usa o custoTotal normal do produto. Ver custoEfetivo em
  // lib/estoque-variacao.ts. Dado interno, nunca sai pela API pública.
  custosValores  Json?
}

// Slide do carrossel da home, editável em /admin/banners. `ordem` é a posição
// no carrossel e `ativo` tira do ar sem apagar o cadastro.
model Banner {
  id         String   @id @default(cuid())
  titulo     String
  eyebrow    String
  precoTexto String
  ctaHref    String
  // Sem imagem o slide usa só `corFundo` — é assim que a loja nasce no seed.
  imagemUrl  String?
  corFundo   String   @default("#3F6B4C")
  ordem      Int      @default(0)
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ativo, ordem])
}

// Pergunta/resposta da página /suporte, editável em /admin/faqs. Antes vinha
// fixo de src/lib/mock-data.ts — mudar uma resposta pedia redeploy; agora é
// dado de loja como banner e cupom. Inativa não sai da área interna, mas some
// da página pública.
model Faq {
  id        String   @id @default(cuid())
  pergunta  String
  resposta  String
  ordem     Int      @default(0)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ativo, ordem])
}

model Usuario {
  id           String        @id @default(cuid())
  nome         String
  email        String        @unique
  cpf          String?       @unique // nullable p/ não quebrar contas antigas; obrigatório na API de registro
  senhaHash    String
  admin        Boolean       @default(false) // libera /admin e /api/admin (ver npm run db:admin)
  // Dados de perfil vindos da tela "Meus dados". E-mail continua sendo trocado
  // só pelo fluxo de segurança (com senha) — não entra aqui.
  telefone     String? // nullable p/ não quebrar contas antigas; obrigatório na API de registro
  aniversario  String? // "YYYY-MM-DD"; opcional, sem uso em regra de negócio
  // Preferências de notificação da tela "Notificações".
  prefEmail     Boolean      @default(true)
  prefWhatsapp  Boolean      @default(true)
  prefSms       Boolean      @default(false)
  prefPromocoes Boolean      @default(false)
  pedidos      Pedido[]
  favoritos    Favorito[]
  notificacoes Notificacao[]
  avaliacoes   Avaliacao[]
  carrinho     CarrinhoItem?
  enderecos    Endereco[]
  createdAt    DateTime      @default(now())
}

// Endereços salvos na tela "Conta > Endereços". O endereço usado de fato em
// cada compra fica congelado em Pedido.enderecoResumo — mudar ou apagar aqui
// não afeta pedido já feito.
model Endereco {
  id           String   @id @default(cuid())
  usuarioId    String
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rotulo       String
  destinatario String
  cep          String
  rua          String
  numero       String
  complemento  String?
  bairro       String
  cidade       String
  uf           String
  // Só um padrão por usuário — garantido em código (ver data/conta.ts), não
  // por constraint, porque exige olhar os outros endereços do mesmo dono.
  padrao       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([usuarioId])
}

// A sacola do usuário logado, espelhando o `ItemCarrinho` do client (um item
// só, com variações, quantidade e personalização). Visitante sem sessão
// continua só no localStorage — ver cart-context.tsx.
//
// `produtoId` não é uma relação de verdade pro `Produto`: uma FK aqui
// travaria a remoção de um produto só porque alguém tem ele numa sacola nunca
// comprada. A tela já lida com produto que sumiu do catálogo (useProduto
// devolve undefined) do mesmo jeito que lida hoje com o item do localStorage.
model CarrinhoItem {
  id                  String   @id @default(cuid())
  usuarioId           String   @unique
  usuario             Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  produtoId           String
  variacoesEscolhidas Json     @default("{}")
  quantidade          Int      @default(1)
  cepInformado        String?
  personalizacao      Json?
  updatedAt           DateTime @updatedAt
}

model Favorito {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  produtoId String
  produto   Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // Favoritar é idempotente: o par não pode repetir (ver upsert em data/favoritos).
  @@unique([usuarioId, produtoId])
}

model Notificacao {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  titulo    String
  mensagem  String
  lida      Boolean  @default(false)
  createdAt DateTime @default(now())

  // A tela e o sininho sempre leem por usuário, do mais recente pro mais antigo.
  @@index([usuarioId, createdAt])
}

model Pedido {
  id              String       @id @default(cuid())
  usuarioId       String
  usuario         Usuario      @relation(fields: [usuarioId], references: [id])
  status          StatusPedido @default(AGUARDANDO_PAGAMENTO)
  // `total` já inclui o frete: é o valor cobrado do cliente.
  total           Decimal      @db.Decimal(10, 2)
  frete           Decimal      @default(0) @db.Decimal(10, 2)
  // Nome do serviço cotado e escolhido (ex: "PAC", "SEDEX") — null quando o
  // frete caiu na estimativa por região (sem transportadora configurada) ou
  // veio zerado por frete grátis.
  freteServico    String?
  // true quando `frete` é 0 por cupom de frete grátis ou pelo limiar
  // automático (ConfiguracaoLoja.freteGratisAcimaDe) — sem isso, um frete
  // zerado no histórico pareceria erro de cálculo em vez de benefício aplicado.
  freteGratis     Boolean      @default(false)
  // Endereço congelado no momento da compra: o cadastro do cliente pode mudar
  // depois, mas o pedido tem que continuar mostrando pra onde foi.
  enderecoCep     String?
  enderecoResumo  String?
  // Número, complemento e destinatário do endereço congelado — sem eles o
  // pedido não tem como ser entregue de fato (rua/bairro/cidade sozinhos não
  // bastam pros Correios). Vêm do Endereco escolhido no checkout, não do
  // ViaCEP, que não sabe número nem quem recebe.
  enderecoDestinatario String?
  enderecoNumero        String?
  enderecoComplemento   String?
  // Preenchido quando o cliente pede devolução, pra loja saber o que houve.
  motivoDevolucao String?
  // Cupom aplicado neste pedido, se houver. O código fica congelado aqui
  // mesmo que o cupom seja editado ou apagado depois.
  cupomCodigo     String?
  desconto        Decimal      @default(0) @db.Decimal(10, 2)
  // Código de rastreio dos Correios, preenchido pelo admin ao marcar o pedido
  // como ENVIADO. Sem ele o cliente só vê o status, sem link de rastreamento.
  codigoRastreio  String?
  itens           ItemPedido[]
  // Sem credencial do Mercado Pago configurada o checkout roda simulado; o
  // campo marca quais pedidos nasceram assim pra não confundir com venda real.
  pagamentoMock   Boolean      @default(true)
  // Id do pagamento no Mercado Pago, preenchido quando o webhook chega. Serve
  // pra conferir um pedido no painel deles quando o cliente reclama.
  pagamentoId     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model ItemPedido {
  id                String          @id @default(cuid())
  pedidoId          String
  pedido            Pedido          @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produtoId         String
  produto           Produto         @relation(fields: [produtoId], references: [id])
  quantidade        Int             @default(1)
  precoUnitario     Decimal         @db.Decimal(10, 2)
  variacaoEscolhida Json?
  personalizacao    Personalizacao?
}

model Personalizacao {
  id           String             @id @default(cuid())
  itemPedidoId String             @unique
  itemPedido   ItemPedido         @relation(fields: [itemPedidoId], references: [id], onDelete: Cascade)
  tipo         TipoPersonalizacao
  arteUrl      String?
  briefing     String?
  aceiteTermos Boolean            @default(false)
  createdAt    DateTime           @default(now())
}

// Cupom de desconto, gerenciado em /admin/cupons. `usos` conta quantos
// pedidos já usaram o código, comparado contra `usoMaximo` (sem limite
// quando null) — o incremento é feito em SQL condicional dentro da transação
// do pedido (ver registrarUsoCupom), pra duas compras simultâneas não
// passarem do limite.
//
// As mesmas regras têm CHECK constraints no banco, que o Prisma não sabe
// descrever aqui: ver prisma/migrations/20260818230000_travas_cupom.
model Cupom {
  id                String     @id @default(cuid())
  codigo            String     @unique
  tipo              TipoCupom
  // Percentual (0–100) quando tipo=PERCENTUAL, valor em R$ quando tipo=FIXO.
  valor             Decimal    @db.Decimal(10, 2)
  ativo             Boolean    @default(true)
  validoAte         DateTime?
  usoMaximo         Int?
  usos              Int        @default(0)
  // Pedido precisa custar pelo menos isso (produto, sem frete) pro cupom valer.
  valorMinimoPedido Decimal    @default(0) @db.Decimal(10, 2)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

enum TipoCupom {
  PERCENTUAL
  FIXO
  FRETE_GRATIS
}

enum TransportadoraFrete {
  MELHOR_ENVIO
  SUPER_FRETE
}

enum StatusPedido {
  AGUARDANDO_PAGAMENTO
  PAGO
  EM_PRODUCAO
  ENVIADO
  ENTREGUE
  DEVOLUCAO_SOLICITADA
  DEVOLVIDO
  CANCELADO
}

enum TipoPersonalizacao {
  IA
  UPLOAD
  MANUAL
}

// Linha única (id fixo "singleton") com dados operacionais da loja editáveis
// pelo admin sem precisar de redeploy: CEP de onde os Correios buscam a
// encomenda e o token da conta Melhor Envio usada pra cotar o frete real.
// Avaliação de produto, feita pelo cliente. Nasce pendente (aprovado = false)
// e só aparece na página do produto depois que o admin aprova — barra spam e
// review ofensiva sem depender de moderação manual em tempo real.
model Avaliacao {
  id         String   @id @default(cuid())
  produtoId  String
  produto    Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  // Nula quando a avaliação é criada pelo admin (sem cliente real por trás) —
  // nesse caso `autorNome` é quem aparece como autor. Postgres não conta
  // NULL como duplicado num índice único, então várias avaliações do admin
  // pro mesmo produto convivem sem esbarrar no @@unique abaixo.
  usuarioId  String?
  usuario    Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  // Só usado quando usuarioId é nulo — nome exibido como autor da review
  // criada pelo admin (ex.: "Cliente via WhatsApp", nome informado à loja).
  autorNome  String?
  criadoPorAdmin Boolean @default(false)
  nota       Int
  comentario String?
  aprovado   Boolean  @default(false)
  createdAt  DateTime @default(now())

  // Um cliente avalia o mesmo produto uma vez só — reenviar edita, não duplica.
  @@unique([produtoId, usuarioId])
}

model ConfiguracaoLoja {
  id               String   @id @default("singleton")
  cepOrigem        String   @default("01310100")
  melhorEnvioToken String?
  superFreteToken  String?
  // Define qual token é usado pra cotação real no checkout. Só uma
  // transportadora fica ativa por vez — trocar aqui não apaga o token da
  // outra, só deixa de consultá-lo.
  transportadoraAtiva TransportadoraFrete @default(MELHOR_ENVIO)
  // Frete grátis automático pra pedidos a partir desse valor (produto, sem
  // frete) — null desliga a regra. Independente de cupom: soma com um cupom
  // FRETE_GRATIS aplicado (o resultado é o mesmo, frete zerado, mas as duas
  // origens coexistem sem conflito).
  freteGratisAcimaDe Decimal? @db.Decimal(10, 2)
  // Defaults globais de margem pra venda manual na Shopee — usados quando o
  // produto não tem override próprio (ver Produto.shopeeComissaoPct e cia).
  // null = 0% nesse componente até ser configurado.
  shopeeComissaoPct Decimal? @db.Decimal(5, 2)
  shopeeFretePct    Decimal? @db.Decimal(5, 2)
  shopeeAdsPct      Decimal? @db.Decimal(5, 2)
  updatedAt        DateTime @updatedAt
}

// Venda lançada manualmente pelo admin quando o mesmo produto é vendido fora
// do site, na Shopee. Reaproveita o custo de material já cadastrado no
// produto (custoEfetivo) em vez de duplicar cadastro. Comissão/frete/ads são
// SNAPSHOT do que estava configurado (produto ou default global) no momento
// do lançamento — mudar a config depois não recalcula vendas já lançadas.
model VendaShopee {
  id            String   @id @default(cuid())
  produtoId     String
  produto       Produto  @relation(fields: [produtoId], references: [id])
  // Chave igual EstoqueVariacao.combinacao — null quando o produto não tem
  // variação, ou quando a venda não distingue combinação.
  combinacao    String?
  quantidade    Int
  // Valor total recebido pela venda (não é unitário).
  valorVenda    Decimal  @db.Decimal(10, 2)
  // Custo de material total da venda (quantidade × custoEfetivo), snapshot.
  custoTotal    Decimal  @db.Decimal(10, 2)
  comissaoPct   Decimal  @db.Decimal(5, 2)
  fretePct      Decimal  @db.Decimal(5, 2)
  adsPct        Decimal  @db.Decimal(5, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([produtoId])
  @@index([createdAt])
}
